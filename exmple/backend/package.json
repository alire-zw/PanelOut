{
  "name": "viraltel-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "tsx src/scripts/run-prisma.ts migrate dev",
    "db:push": "tsx src/scripts/run-prisma.ts db push",
    "db:studio": "tsx src/scripts/run-prisma.ts studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.11.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "grammy": "^1.36.0",
    "ioredis": "^5.6.1",
    "jalaali-js": "^2.0.0",
    "mysql2": "^3.14.2",
    "sharp": "^0.35.3",
    "tronweb": "^6.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.16.0",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
