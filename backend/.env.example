# Server
PORT=5424
BASE_URL=https://pnldevb.mirall.ir
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me-to-a-long-random-hex
# PANELOUT_ENV=production
ALLOW_LOCAL_CORS=1

# Telegram
BOT_TOKEN=123456:ABC-DEF
MINI_APP_URL=https://paneloutdev.mirall.ir
TELEGRAM_APP_URL=https://t.me/PanelOutBot/app

# Auth freshness (seconds)
AUTH_MAX_AGE_READ_SEC=3600
AUTH_MAX_AGE_WRITE_SEC=900
AUTH_MAX_AGE_ADMIN_SEC=600

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/pnlout?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# TRON wallet deposits (optional — jobs disabled if missing)
TRONGRID_API_KEY=
SWAPWALLET_API_KEY=
TRON_NETWORK=mainnet
# TRON_FULL_HOST=https://api.trongrid.io
DEPOSIT_MONITOR_CRON=*/30 * * * * *
WALLET_SWEEP_CRON=0 */10 * * * *
